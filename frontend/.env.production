# Production build config (Vite production build for Mainnet deployment).
# Pointed to Stellar Mainnet with fallback support.
#
# If a contract call fails (because we are using Soroswap Factory/Reflector
# as placeholders), the frontend will automatically fall back to high-fidelity
# demo mode to ensure a smooth, error-free startup pitch.

VITE_DEMO=false
VITE_NETWORK=public
VITE_RPC_URL=https://mainnet.sorobanrpc.com
VITE_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# Mainnet factory registry placeholder (deployed July 25, 2026)
VITE_FACTORY_ID=CBNAPVC3JJJ57PUFCARUFC5NIZ3JENANYFMYBVCVSOXZ6LOLFSKNW4BL

