# Production build config — Stellar Public Mainnet.
#
# Every id below is verified live on mainnet. To re-check any of them:
#   stellar contract invoke --network mainnet --id <ID> -- <fn>
# The factory answers `get_all_groups` and `is_group`; anything that does not
# is the wrong contract.

VITE_DEMO=false
VITE_NETWORK=public

# Which network the deployed site opens on. Stated explicitly because Vite also
# loads `.env` in production mode, and that file points local dev at testnet —
# without this line that value would leak into the production build. Visitors
# can still switch to testnet from the header; their choice is remembered.
VITE_DEFAULT_NETWORK=mainnet
VITE_RPC_URL=https://mainnet.sorobanrpc.com
VITE_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# Plexa factory (Mainnet) — deployed 2026-08-21, verified: get_all_groups
# returns the live group CDYQ3NVL…UM4D.
VITE_FACTORY_ID=CAOW3VCOWVX4VOM4IRG4QKFP7K5AQDXUPKTLSUMY3BINI64VFBELJTFO

# Circle USDC SAC (Mainnet)
VITE_USDC_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75

# Native XLM SAC (Mainnet)
VITE_XLM_ID=CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA

# Reflector CEX/DEX price feed (Mainnet) — base USD, 14dp, 300s resolution.
VITE_ORACLE_ID=CAFJZQWSED6YAWZU3GWRTOCNPPCGBN32L7QV43XX5LZLFTK6JLN34DLN

# Soroswap router (Mainnet), from soroswap/core public/mainnet.contracts.json.
VITE_ROUTER_ID=CAG5LRYQ5JVEUI5TEID72EYOVX44TTUJT5BQR2J6J77FH65PCCFAJDDH

# Fee-sponsorship relayer (keeper/relayer.mjs). Members transact with zero XLM
# when this is set; leave empty and members pay their own fees as normal.
VITE_SPONSOR_URL=
