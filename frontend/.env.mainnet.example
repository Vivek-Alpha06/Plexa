# Plexa — MAINNET (Stellar public network) configuration template.
#
# Copy to `.env.production` (or set these in the Vercel dashboard) only when you
# are deliberately shipping the mainnet build. Real money moves through these
# addresses; a wrong id here loses funds rather than erroring.
#
#   cp .env.mainnet.example .env.production
#
# The three ids marked FILL IN do not exist until `scripts/deploy.sh` has run
# against mainnet — take them from its output.

VITE_DEMO=false

# Visitors can still switch to testnet from the header — the testnet ids are
# built in. Set VITE_DEFAULT_NETWORK=testnet if you would rather a first-time
# visitor land there and opt in to mainnet deliberately.
VITE_NETWORK=public
VITE_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# Soroban RPC. There is no free public mainnet endpoint with an availability
# guarantee — use your own provider (QuickNode, Validation Cloud, Nodies,
# Blockdaemon) or self-host. The value below works but is rate-limited and
# unsuitable as a production dependency.
VITE_RPC_URL=https://mainnet.sorobanrpc.com

# --- Deployed by scripts/deploy.sh ------------------------------------------
# FILL IN from the deploy output.
VITE_FACTORY_ID=
VITE_ORACLE_ID=

# --- Existing mainnet contracts (verified 2026-08-16) ------------------------
# Native XLM Stellar Asset Contract.
VITE_XLM_ID=CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA

# Circle USDC SAC — asset USDC:GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
VITE_USDC_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75

# Soroswap router — soroswap/core `public/mainnet.contracts.json`.
# The XLM/USDC pair is CAM7DY53G63XA4AJRS24Z6VFYAFSSF76C3RZ45BE5YU3FQS5255OOABP.
# Check its reserves before launch: liquidations sell XLM collateral into this
# pool, and it is not deep. See README "Mainnet readiness".
VITE_ROUTER_ID=CAG5LRYQ5JVEUI5TEID72EYOVX44TTUJT5BQR2J6J77FH65PCCFAJDDH
