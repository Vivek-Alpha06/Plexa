# Copy to `.env` (cp .env.example .env). These are the live public TESTNET
# contract ids — no secrets — so the app runs against testnet out of the box.
#
# Prefer a zero-setup run? Set VITE_DEMO=true for a fully local, in-memory
# demo (no wallet, no network required).
VITE_DEMO=false

VITE_NETWORK=testnet
VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Plexa v8 testnet deployment (Reflector oracle, upgrade timelocks, registry
# verification). Keep this in step with frontend/.env — a stale factory id does
# not error, it silently reads a different registry.
VITE_FACTORY_ID=CDOYIGNCIR4QTUTAUYEFSW7IJVS6ZMOFV6CW574VFGHQ5ZDCQCJZ4GDZ
VITE_USDC_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Multi-collateral: native XLM SAC + Reflector oracle adapter + Soroswap router.
VITE_XLM_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
VITE_ORACLE_ID=CADEJYCKYSWL7V5HKMPV5ZYGLU7G6PCZ4WPASQT26FIGVSRIP3ZZ7DE5
VITE_ROUTER_ID=CCJUD55AG6W5HAI5LRVNKAE5WDP5XGZBUDS5WNTIVDU7O264UZZE7BRD

# Deploying to mainnet instead? See .env.mainnet.example.

# Fee-sponsorship relayer (keeper/relayer.mjs). Set this to the relayer's URL
# to let members transact without holding XLM. Empty = members pay their own fees.
VITE_SPONSOR_URL=
